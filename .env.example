GEMINI_API_KEY=put_your_google_ai_studio_api_key_here
# Hosted Gemma 4 model on Gemini API:
GEMINI_MODEL=gemma-4-26b-a4b-it
# Alternative: choose a Gemini model available to your API key, e.g. gemini-2.5-flash
DATABASE_PATH=video_history.db
SYSTEM_PROMPT_PATH=system_prompt.txt

# Turso cloud database credentials
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token
